# ── NEXUS environment ─────────────────────────────────────────────
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# Supabase (Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<...>
# Server-side only — the service role key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<...>

# AI provider — Google Gemini (free tier). Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=<...>
GEMINI_MODEL=gemini-3.5-flash

# Web research — Tavily. Get a key at https://tavily.com
TAVILY_API_KEY=tvly-<...>

# AI rate limiting (optional). Max AI requests per user per hour.
# Defaults to 40 when unset.
# AI_RATE_LIMIT_PER_HOUR=40

# Optional: custom email provider (recommended for many users —
# removes Supabase's ~4 emails/hour free-tier cap)
# RESEND_API_KEY=re_<...>